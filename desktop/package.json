{
  "name": "lendmyai-desktop",
  "version": "0.2.1",
  "description": "lendmyai for macOS: lend your AI to open projects, or review all pull requests, without a terminal.",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "prepare-app": "node prepare.cjs",
    "start": "npm run prepare-app && electron .",
    "pack": "npm run prepare-app && electron-builder --mac --dir",
    "dist": "npm run prepare-app && electron-builder --mac"
  },
  "build": {
    "appId": "com.lendmyai.owner",
    "productName": "lendmyai",
    "files": [
      "main.cjs",
      "bundle/**",
      "build/icon.png",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
