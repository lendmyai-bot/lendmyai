{
  "name": "lendmyai",
  "version": "0.8.2",
  "description": "Lend your AI to open GitHub tasks. Your agent runs on your computer with your own subscription.",
  "type": "module",
  "bin": {
    "lendmyai": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/*.test.js",
    "web"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test dist/*.test.js",
    "prepare": "tsc",
    "dev:web": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.147.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tholtman1-del/lendmyai.git"
  },
  "homepage": "https://lendmyai.com"
}
